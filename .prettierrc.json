{
  "printWidth": 140,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "embeddedLanguageFormatting": "off",
  "overrides": [{ "files": ["*.yml", "*.yaml", "*.json", "*.md"], "options": { "tabWidth": 2 } }]
}
